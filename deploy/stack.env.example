# Portainer / Swarm: cole estes pares em Environment ou use como deploy/stack.env (não commitar).
#
# Modelo actual: Postgres com DATABASE_URL + SESSION_SECRET — não usar Supabase/API keys dessa suite.
#
# Fluxo típico (PowerShell):
#   Copie este ficheiro → deploy/stack.env, preencha;
#   .\deploy\build.ps1            # imagem com NEXT_PUBLIC_* do stack.env
#   docker stack deploy ...
#
# O Next.js embute NEXT_PUBLIC_* no bundle na hora do build. Runtime sozinho não “corrige” URL de app no JS do cliente.
#
# Ver também deploy/stack-proeduka.yml.

# ═══════════════════════════════════════════════════════════════════════════
# Runtime (PostgreSQL direto — substitui Supabase no código atual)
# ═══════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://USER:SENHA@HOST:5432/NOME_BD
SESSION_SECRET=substitua_por_um_segredo_aleatorio_com_pelo_menos_32_caracteres
# Opcional: UUID GoTrue herdado das migrações (omitir usa default no código)
# AUTH_INSTANCE_ID=00000000-0000-0000-0000-000000000000

# Bootstrap automático do primeiro master no arranque
BOOTSTRAP_MASTER_EMAIL=
BOOTSTRAP_MASTER_PASSWORD=
BOOTSTRAP_MASTER_NAME=

PROFILES_NAME_COLUMN=nome

# ═══════════════════════════════════════════════════════════════════════════
# Build + bundle (NEXT_PUBLIC_* — obrigatórias no docker build via build.ps1 / build.sh)
# ═══════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=https://portal.exemplo.com.br
NEXT_PUBLIC_ALUNOS_TABLE=proeduka_alunos
# Ícone/logo da marca no layout (opcional).
# NEXT_PUBLIC_BRAND_LOGO_URL=https://...

# ═══════════════════════════════════════════════════════════════════════════
# Armazenamento B2 / cron interno / PDF Chromium
# ═══════════════════════════════════════════════════════════════════════════
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_S3_ENDPOINT=
B2_REGION=us-east-005
CRON_SECRET=
ENABLE_INTERNAL_CRON=true
# BIRTHDAY_CRON_SCHEDULE=0 8 * * *
# BIRTHDAY_CRON_TIMEZONE=America/Sao_Paulo
# CHROMIUM_PATH=/usr/bin/chromium
