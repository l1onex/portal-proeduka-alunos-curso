# ═══════════════════════════════════════════════════════════════════════════
# Cópia local (dev): renomeie/copie para `.env` — não commitar valores reais.
# Docker/Swarm: use também `deploy/stack.env` para build + runtime (ver stack.env.example).
# ═══════════════════════════════════════════════════════════════════════════

# --- Postgres (servidor/API; obrigatório em produção) ---
DATABASE_URL=postgresql://USER:SENHA@HOST:5432/NOME_BD
SESSION_SECRET=substitua_por_um_segredo_aleatorio_com_pelo_menos_32_caracteres

# Omitir DDL automático ao arranque (`next_registro_escolar`; uso raro — user Postgres sem permissão CREATE).
# PROEDUKA_SKIP_REGISTRO_BOOTSTRAP=1

# Instância GoTrue (opcional): UUID único por projetos Supabase; em Postgres próprio pode omitir (usa zeros no código).
# AUTH_INSTANCE_ID=00000000-0000-0000-0000-000000000000

# --- Públicas (embutidas no `next build` / Docker — precisam bater entre build e bundle) ---
NEXT_PUBLIC_APP_URL=https://portal.exemplo.com.br
BOOTSTRAP_MASTER_EMAIL=
BOOTSTRAP_MASTER_PASSWORD=
BOOTSTRAP_MASTER_NAME=
NEXT_PUBLIC_ALUNOS_TABLE=proeduka_alunos

# --- Perfis administrativos (coluna do nome em public.profiles) ---
PROFILES_NAME_COLUMN=nome

# --- Opcional CRON integrado (aniversários) ---
ENABLE_INTERNAL_CRON=true
CRON_SECRET=

# --- Backblaze B2 (uploads / presign) ---
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_S3_ENDPOINT=
B2_REGION=us-east-005
